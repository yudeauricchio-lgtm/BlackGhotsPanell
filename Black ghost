local function startFloating()
    if floatConnection then floatConnection:Disconnect() end
    floatConnection = RunService.RenderStepped:Connect(function()
        if ghostFrame and ghostFrame.Parent then
            local currentY = ghostFrame.Position.Y.Offset
            if floatUpwards then
                ghostFrame.Position = UDim2.new(ghostFrame.Position.X.Scale, ghostFrame.Position.X.Offset, 0.5, currentY - 0.4)
                if currentY <= -185 then floatUpwards = false end
            else
                ghostFrame.Position = UDim2.new(ghostFrame.Position.X.Scale, ghostFrame.Position.X.Offset, 0.5, currentY + 0.4)
                if currentY >= -155 then floatUpwards = true end
            end
        end
    end)
end

