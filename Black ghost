local function showNotification(message, color)
    if not ScreenGui then return end
    local notif = Instance.new("Frame", ScreenGui)
    notif.Size = UDim2.new(0, 300, 0, 40)
    notif.Position = UDim2.new(0.5, -150, 0.8, 0)
