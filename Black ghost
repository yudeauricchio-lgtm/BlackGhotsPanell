        local fadeOut = TweenService:Create(notif, TweenInfo.new(0.5), {BackgroundTransparency = 1})
        fadeOut:Play()
        fadeOut.Completed:Connect(function() notif:Destroy() end)
    end)
end

local function createFPSDisplay()
    if fpsLabel then
        pcall(function() fpsLabel:Remove() end)
        fpsLabel = nil
    end
    if not showFps then return end
    fpsLabel = Drawing.new("Text")
    fpsLabel.Visible = true
    fpsLabel.Center = false
    fpsLabel.Outline = false
    fpsLabel.Font = 2
    fpsLabel.Size = 16
    fpsLabel.Color = Color3.fromRGB(255, 0, 0)
    fpsLabel.Position = Vector2.new(Camera.ViewportSize.X - 60, 15)
end

local function createFPSGhosts()
    for _, ghost in pairs(fpsGhosts) do
        pcall(function() ghost:Remove() end)
    end
    fpsGhosts = {}
    if not showFps then return end
    for i = 1, 4 do
        local ghost = Drawing.new("Text")
        ghost.Visible = true
        ghost.Center = true
        ghost.Outline = false
        ghost.Font = 2
        ghost.Size = 12
        ghost.Color = Color3.fromRGB(255, 0, 0)
        ghost.Text = "👻"
        table.insert(fpsGhosts, ghost)
    end
end

local function updateFPSGhosts()
    if not showFps or not fpsLabel then return end
    local centerX = Camera.ViewportSize.X - 60
    local centerY = 15
    local angles = {0, 90, 180, 270}
    local radius = 35
    for i, ghost in ipairs(fpsGhosts) do
        local angle = math.rad(angles[i] + (tick() * 50) % 360)
        local x = centerX + math.cos(angle) * radius
        local y = centerY + math.sin(angle) * radius
        ghost.Position = Vector2.new(x, y)
    end
end

local function updateFPS()
    frameCount = frameCount + 1
    local currentTime = tick()
    if currentTime - lastTime >= 1 then
        currentFps = frameCount
        frameCount = 0
        lastTime = currentTime
        if fpsLabel and showFps then
            fpsLabel.Color = Color3.fromRGB(255, 0, 0)
            fpsLabel.Text = string.format("FPS: %d", currentFps)
            fpsLabel.Position = Vector2.new(Camera.ViewportSize.X - 60, 15)
            updateFPSGhosts()
        end
    end
end

local function teleportToMouse()
    local mouse = LocalPlayer:GetMouse()
    if not mouse then return end
    local position = mouse.Hit.p
    if position and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(position.X, position.Y + 3, position.Z)
        showNotification("✨ Teleportado! ✨", Color3.fromRGB(0, 255, 0))
    end
end

local function applyGlitchEffect(frame, duration)
    if not frame then return end
    local originalPosition = frame.Position
    local originalSize = frame.Size
    local glitchFrames = {}
    for i = 1, 3 do
        local glitch = Instance.new("Frame", frame.Parent)
        glitch.Size = frame.Size
        glitch.Position = frame.Position
        glitch.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
        glitch.BackgroundTransparency = 0.5
        glitch.BorderSizePixel = 0
        glitch.ZIndex = frame.ZIndex + 10
        glitch.Visible = false
        table.insert(glitchFrames, glitch)
    end
    local startTime = tick()
    local connection
    connection = RunService.RenderStepped:Connect(function()
        local elapsed = tick() - startTime
        if elapsed >= duration then
            for _, glitch in ipairs(glitchFrames) do
                glitch:Destroy()
            end
            frame.Position = originalPosition
            frame.Size = originalSize
            connection:Disconnect()
            return
        end
        if frame.Visible then
            local offsetX = math.random(-8, 8)
            local offsetY = math.random(-4, 4)
            frame.Position = UDim2.new(originalPosition.X.Scale, originalPosition.X.Offset + offsetX, 
                                       originalPosition.Y.Scale, originalPosition.Y.Offset + offsetY)
            local widthOffset = math.random(-5, 5)
            local heightOffset = math.random(-3, 3)
            frame.Size = UDim2.new(originalSize.X.Scale, originalSize.X.Offset + widthOffset,
                                   originalSize.Y.Scale, originalSize.Y.Offset + heightOffset)
            for _, glitch in ipairs(glitchFrames) do
                if math.random(1, 3) == 1 then
                    glitch.Visible = true
                    glitch.Position = UDim2.new(originalPosition.X.Scale, originalPosition.X.Offset + math.random(-15, 15),
                                               originalPosition.Y.Scale, originalPosition.Y.Offset + math.random(-10, 10))
                    glitch.Size = UDim2.new(originalSize.X.Scale, originalSize.X.Offset + math.random(-20, 20),
                                           originalSize.Y.Scale, originalSize.Y.Offset + math.random(-10, 10))
                    glitch.BackgroundColor3 = math.random(1, 2) == 1 and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(0, 0, 0)
                    glitch.BackgroundTransparency = math.random(30, 70) / 100
                    task.delay(0.05, function()
                        glitch.Visible = false
                    end)
                end
            end
        end
    end)
end

local function toggleMinimize()
    if not MainFrame or not MinimizedFrame then return end
    minimized = not minimized
    if minimized then
        savedPosition = MainFrame.Position
        applyGlitchEffect(MainFrame, 0.3)
        task.wait(0.15)
        MainFrame.Visible = false
        MinimizedFrame.Visible = true
        MinimizedFrame.Position = savedPosition
        applyGlitchEffect(MinimizedFrame, 0.2)
        if ColorMenu then ColorMenu.Visible = false end
        if KeyMenu then KeyMenu.Visible = false end
        if AimbotKeyMenu then AimbotKeyMenu.Visible = false end
    else
        applyGlitchEffect(MinimizedFrame, 0.2)
        task.wait(0.15)
        MainFrame.Visible = true
        MinimizedFrame.Visible = false
        if savedPosition then MainFrame.Position = savedPosition end
        applyGlitchEffect(MainFrame, 0.3)
    end
end

local function getTeamColor(player)
    if player.Team then
        local teamColor = player.Team.TeamColor
        if teamColor then
            return teamColor.Color
        end
    end
    return Color3.fromRGB(255, 255, 255)
end

local function getFontSizeByDistance(distance)
    local clampedDistance = math.clamp(distance, 5, 150)
    local size = 16 - (clampedDistance - 5) * (8 / 145)
    return math.max(8, math.min(16, size))
end

local function getLifeFontSizeByDistance(distance)
    local clampedDistance = math.clamp(distance, 5, 200)
    local size = 16 - (clampedDistance - 5) * (8 / 195)
    return math.max(7, math.min(16, size))
end

local function isPlayerAlive(player)
    local character = player.Character
    if not character then return false end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false end
    return humanoid.Health > 0
end

