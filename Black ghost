        aimbotSection.TextColor3 = anyAimbotActive and GREEN_COLOR or RED_COLOR
    end
    if extraSection then
        local anyExtraActive = showFps or tpEnabled
        extraSection.TextColor3 = anyExtraActive and GREEN_COLOR or RED_COLOR
    end
