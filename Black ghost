local function updateAllESP()
    if not espEnabled then return end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local esp = espObjects[player]
            if not esp then
                createESP(player)
                esp = espObjects[player]
            end
            if esp and esp.nameTag then
                esp.nameTag.Color = getTeamColor(player)
            end
            local char = player.Character
            if char and char:FindFirstChild("Head") then
                if teamCheck and player.Team == LocalPlayer.Team then
                    if esp then
                        esp.nameTag.Visible = false
                        esp.distanceText.Visible = false
                    end
                else
                    local head = char.Head
                    local headPos, headOnScreen = Camera:WorldToViewportPoint(head.Position)
                    if headOnScreen then
                        local distance = (Camera.CFrame.Position - head.Position).Magnitude
                        local displayDistance = math.floor(distance)
                        local fontSize = getFontSizeByDistance(distance)
                        if espNicksEnabled then
                            esp.nameTag.Position = Vector2.new(headPos.X, headPos.Y - 35)
                            esp.nameTag.Text = player.Name
                            esp.nameTag.Size = fontSize
                            esp.nameTag.Visible = true
                        else
                            esp.nameTag.Visible = false
                        end
                        if espDistanceEnabled then
                            esp.distanceText.Position = Vector2.new(headPos.X, headPos.Y - 20)
                            esp.distanceText.Text = displayDistance .. "m"
                            esp.distanceText.Size = math.max(8, fontSize - 2)
                            esp.distanceText.Visible = true
                        else
                            esp.distanceText.Visible = false
                        end
                    else
                        if esp then
                            esp.nameTag.Visible = false
                            esp.distanceText.Visible = false
                        end
                    end
                end
            elseif esp then
                esp.nameTag.Visible = false
                esp.distanceText.Visible = false
            end
        end
    end
end

